# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# --- LLM backend (default: Claude via Anthropic) ---
ANTHROPIC_API_KEY=

# For a local model (Ollama / LM Studio / llama.cpp):
#   LLM_BACKEND=openai
#   LLM_BASE_URL=http://localhost:11434/v1     # Ollama (LM Studio: http://localhost:1234/v1)
#   LLM_MODEL=qwen2.5:14b
#   LLM_API_KEY=local                          # any value; local servers ignore it
LLM_BACKEND=anthropic
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- Bitrix24 (incoming webhook, pre-authenticated) ---
BITRIX_WEBHOOK=https://portal.truckradar.com/rest/17301/<token>/

# --- Power BI / Microsoft Entra (service principal) ---
TENANT_ID=
CLIENT_ID=
